# Copy to .env and fill in your own values. Never commit .env.

# PostgreSQL
POSTGRES_DB=cirt
POSTGRES_USER=cirt_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cirt_app:<POSTGRES_PASSWORD>@localhost:5432/cirt

# MongoDB
MONGO_ROOT_USER=cirt_root
MONGO_ROOT_PASSWORD=
MONGO_DB=cirt
MONGO_PORT=27017
MONGODB_URI=mongodb://cirt_root:<MONGO_ROOT_PASSWORD>@localhost:27017/?authSource=admin

# Auth: generate with  openssl rand -base64 48
JWT_SECRET=
